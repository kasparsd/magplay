{
  "name": "magplay",
  "private": true,
  "description": "Search a Torznab indexer, stream a torrent's video in the browser",
  "license": "MIT",
  "author": "Kaspars Dambis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasparsd/magplay.git"
  },
  "homepage": "https://github.com/kasparsd/magplay",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prestart": "npm run build",
    "start": "node apps/server/src/main.ts",
    "test": "npm run build && node --test '{apps,packages}/**/*.test.{js,ts}'",
    "test:e2e": "npm run build && playwright test",
    "test:peers": "node --test tests/integration/*.test.js",
    "test:observability": "node tools/scripts/check-observability.mjs",
    "test:all": "npm test && npm run test:peers && npm run test:e2e",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:publish": "node tools/scripts/release-publish.mjs",
    "build": "esbuild 'apps/client/src/*.js' 'apps/client/src/*.ts' --bundle --minify --format=esm --sourcemap --outdir=dist/client",
    "dev": "npm run build -- --watch & node --watch apps/server/src/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "bittorrent-tracker": "11.2.3",
    "create-torrent": "6.1.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "neostandard": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-datachannel@0.32.3": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "utp-native@2.5.3": true,
    "ip-set@3.0.0": false
  }
}
